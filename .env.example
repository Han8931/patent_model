# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# LLM API
# ---------------------------------------------------------------------------
LLM_MODEL=gpt-oss:120b
LLM_BASE_URL=http://localhost:11434/v1   # Ollama default; change for OpenAI etc.
LLM_API_KEY=ollama                        # use real key for OpenAI / cloud APIs
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Trailing-context window for description (body) translation. Each body chunk
# gets the last N already-translated chunks prepended as read-only context so
# the model keeps pronoun/antecedent and parallel-structure consistency across
# chunk boundaries. 0 disables. Claims (bulk single call) are unaffected.
LLM_CONTEXT_BACK=2

# ---------------------------------------------------------------------------
# AWS / S3
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

S3_ENDPOINT_URL=                          # leave empty for AWS; set for MinIO / R2 / etc.
S3_BUCKET=your-bucket-name
S3_PREFIX=patents/korean/                 # key prefix to filter (leave empty for entire bucket)
S3_DOWNLOAD_DIR=data/s3                   # local directory to download files into
