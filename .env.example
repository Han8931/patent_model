# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# LLM API — default OpenAI-compatible provider (Ollama / OpenAI / vLLM / ...)
# Used when ``--gauss`` is NOT passed. LLM_TEMPERATURE and LLM_MAX_TOKENS
# apply to both providers.
# ---------------------------------------------------------------------------
LLM_MODEL=gpt-oss:120b
LLM_BASE_URL=http://localhost:11434/v1   # Ollama default; change for OpenAI etc.
LLM_API_KEY=ollama                        # use real key for OpenAI / cloud APIs
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Samsung Gauss-O4 endpoint — used when ``--gauss`` is passed on the CLI.
# These add static auth/identity headers on every request:
#   x-dep-ticket       ← GAUSS_CREDENTIAL
#   Send-System-Name   ← GAUSS_SYSTEM_NAME
#   User-Id            ← GAUSS_USER_ID         (your KNOX ID)
#   User-Type          ← GAUSS_USER_TYPE       (default: AD_ID)
# Plus per-request UUID headers (Prompt-Msg-Id, Completion-Msg-Id) the
# client generates automatically.
# ---------------------------------------------------------------------------
GAUSS_MODEL=GaussO4.1-260330
GAUSS_BASE_URL=                           # full https URL to the Gauss endpoint
GAUSS_API_KEY=                            # bearer key (or reuse OPENAI_API_KEY)
GAUSS_CREDENTIAL=                         # x-dep-ticket value
GAUSS_USER_ID=                            # your KNOX ID
GAUSS_SYSTEM_NAME=patent_translator
GAUSS_USER_TYPE=AD_ID

# ---------------------------------------------------------------------------
# AWS / S3
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

S3_ENDPOINT_URL=                          # leave empty for AWS; set for MinIO / R2 / etc.
S3_BUCKET=your-bucket-name
S3_PREFIX=patents/korean/                 # key prefix to filter (leave empty for entire bucket)
S3_DOWNLOAD_DIR=data/s3                   # local directory to download files into
