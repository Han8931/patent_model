@startuml claims_detail
title Claims Translation - Two-Stage Detail

skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam shadowing false
skinparam roundCorner 6
skinparam ranksep 12
skinparam nodesep 8
skinparam ArrowColor #555
skinparam activity {
  BackgroundColor #FAFAFA
  BorderColor #888
  DiamondBackgroundColor #FFF7DD
  DiamondBorderColor #C49A00
}
skinparam partition {
  BackgroundColor #F5F5FA
  BorderColor #AAA
  FontStyle bold
}

start

partition "  Pre-pass — deterministic  " #FCEAEA {
  :**chunk_claims** — group by claim header,
  number EQUATIONs;
  :**_classify_chunks** — classify every claim
  pass 1: parse_dependency + detect_kind
  pass 2: dependents inherit parent's kind;
  note right
    Each claim Chunk now has:
    claim_kind: device|method|crm|system
    is_independent, parent_claim_nums
    multi_parent_kind: single|or|range
  end note
}

partition "  Phase 1 — independents (claim-num order)  " #EAF7EA {
  repeat
    :**build_claim_messages** (is_independent=True)
    routes to per-kind system prompt;
    :**LLMClient.complete**;
    :**extract_preamble** → noun_phrase
    (+ actor_phrase for crm/system);
    :store **PreambleSpec** by claim_num
    merge key_terms into glossary;
  repeat while (more independents?)
}

partition "  Phase 2 — dependents (source order)  " #EAF1F8 {
  repeat
    if (parent's PreambleSpec found?) then (yes)
      if (kind == method?) then (yes)
        :**method_dependent_connective**
        further comprising | wherein;
      else (no)
        :connective = wherein;
      endif
      :**build_dependent_preamble**
      "The {noun_phrase} of {parent_ref}"
      parent_ref: claim N | N or M | any one of N..M;
      :**build_claim_messages** (is_independent=False)
      PREAMBLE LOCK in user prompt;
    else (no)
      :fallback to indep prompt
      log warning;
    endif
    :**LLMClient.complete**, postprocess
    merge key_terms into glossary;
  repeat while (more dependents?)
}

:hand off to **write** node;
stop
@enduml
